<?xml version="1.0" encoding="utf-8"?>
<!-- Only the optional engine is listed: the stored provider choice (Settings.Global webview_provider = com.android.webview)
     is then not a valid provider and WebViewUpdateService falls back to the first valid one in this list. The signature
     element keeps the check when ro.debuggable is 0 (7.1.1 skips it on debuggable builds). Certificate: CN=Embrith WebView,
     SHA-256 2C:A8:61:E5:B8:29:F5:AB:A0:BE:12:B7:AB:FA:E4:F3:8F:99:AC:47:B1:20:4E:47:CA:6D:85:5F:63:8C:E5:8E. -->
<webviewproviders>
    <webviewprovider description="Chromium 119 WebView" packageName="com.embrith.webview" availableByDefault="true">
        <signature></signature>
    </webviewprovider>
</webviewproviders>
